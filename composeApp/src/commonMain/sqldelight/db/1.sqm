-- Version 1 -> 2: rep range + weight step per exercise, and exercise ratings.
ALTER TABLE exercise ADD COLUMN rep_min INTEGER NOT NULL DEFAULT 8;
ALTER TABLE exercise ADD COLUMN rep_max INTEGER NOT NULL DEFAULT 12;
ALTER TABLE exercise ADD COLUMN weight_increment REAL NOT NULL DEFAULT 2.5;

CREATE TABLE exercise_rating (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    exercise_id TEXT NOT NULL,
    rating TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    dirty INTEGER NOT NULL DEFAULT 1
);
