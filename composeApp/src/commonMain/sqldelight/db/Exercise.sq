-- Every synced table has: updated_at (client ms), deleted (soft delete), dirty (pending upload).
CREATE TABLE exercise (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    muscle_group TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    dirty INTEGER NOT NULL DEFAULT 1
);

selectActive:
SELECT * FROM exercise WHERE deleted = 0 ORDER BY name COLLATE NOCASE;

selectById:
SELECT * FROM exercise WHERE id = ?;

selectDirty:
SELECT * FROM exercise WHERE dirty = 1;

upsert:
INSERT OR REPLACE INTO exercise(id, name, muscle_group, updated_at, deleted, dirty)
VALUES (?, ?, ?, ?, ?, ?);

markClean:
UPDATE exercise SET dirty = 0 WHERE id = ? AND updated_at = ?;

countDirty:
SELECT count(*) FROM exercise WHERE dirty = 1;
