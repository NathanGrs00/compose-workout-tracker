-- rep_min/rep_max: target rep range; weight_increment: weight step used for suggestions.
-- target_sets: planned sets per workout; rest_seconds: rest between sets.
-- Every synced table has: updated_at (client ms), deleted (soft delete), dirty (pending upload).
CREATE TABLE exercise (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    muscle_group TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    deleted INTEGER NOT NULL DEFAULT 0,
    dirty INTEGER NOT NULL DEFAULT 1,
    rep_min INTEGER NOT NULL DEFAULT 8,
    rep_max INTEGER NOT NULL DEFAULT 12,
    weight_increment REAL NOT NULL DEFAULT 2.5,
    target_sets INTEGER NOT NULL DEFAULT 3,
    rest_seconds INTEGER NOT NULL DEFAULT 90
);

selectActive:
SELECT * FROM exercise WHERE deleted = 0 ORDER BY name COLLATE NOCASE;

selectById:
SELECT * FROM exercise WHERE id = ?;

selectDirty:
SELECT * FROM exercise WHERE dirty = 1;

upsert:
INSERT OR REPLACE INTO exercise(id, name, muscle_group, rep_min, rep_max, weight_increment, target_sets, rest_seconds, updated_at, deleted, dirty)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

markClean:
UPDATE exercise SET dirty = 0 WHERE id = ? AND updated_at = ?;

countDirty:
SELECT count(*) FROM exercise WHERE dirty = 1;
